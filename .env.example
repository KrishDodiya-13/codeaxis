# Copy to .env.local, or export these in your shell. Server-side only.

# Groq API key. Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional. Overrides the default model (openai/gpt-oss-120b). Any Groq model that
# supports structured outputs; see https://console.groq.com/docs/structured-outputs
# GROQ_MODEL=openai/gpt-oss-20b
