{
  "name": "brandstate",
  "version": "0.1.0",
  "description": "A brand strategy pipeline built around a single threaded BrandState object.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "brandstate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "dev": "node --experimental-strip-types src/cli.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "clsx": "^2.1.1",
    "meshline": "^3.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.7.0"
  }
}
