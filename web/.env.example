# Copy this file to web/.env.local and fill it in. .env.local is gitignored.

# --- Model credential (REQUIRED) -----------------------------------------------
# Groq. Server-side only: the stages call the model in-process, so this key never
# leaves the server and is never bundled for the browser.
# Never rename this to NEXT_PUBLIC_ANYTHING — that would ship it to the client.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional. Overrides the default model (openai/gpt-oss-120b). Any Groq model that
# supports structured outputs; see https://console.groq.com/docs/structured-outputs
# GROQ_MODEL=openai/gpt-oss-20b

# --- Authentication (REQUIRED) -------------------------------------------------
# Signing key for session cookies. Server-side only — never NEXT_PUBLIC_.
# Generate one:  npx auth secret     (or: openssl rand -base64 32)
# Changing it signs everyone out, which is the intended way to revoke all sessions.
AUTH_SECRET=

# The deployment's own URL. Needed so the OAuth callback is built correctly behind a
# proxy. Locally this can be left unset; Auth.js infers http://localhost:3000.
# AUTH_URL=https://brandos.example.com

# --- Google sign-in (OPTIONAL) -------------------------------------------------
# Leave both blank and the "Continue with Google" button is hidden rather than broken.
# Create credentials at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised redirect URI: http://localhost:3000/api/auth/callback/google
#     (and the same path on your deployed origin)
# The secret is read server-side only and never reaches the browser.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- AI mode -------------------------------------------------------------------
# live (default) calls the provider. mock serves deterministic fixtures from
# src/mock/fixtures.ts and makes no external request, so the whole workflow can be
# developed with no key and no quota. Mock is labelled in the server log only.
# A value that is neither is a startup error rather than a silent fallback to live.
AI_MODE=live

# --- Email delivery (REQUIRED for password recovery) ---------------------------
# Which provider sends the reset code.
#   file    development default. Writes the message to .mail/ (gitignored) instead of
#           sending it, so the flow is testable with no account. REFUSED in production.
#   smtp    any SMTP server. Also needs: npm install nodemailer
#   resend  https://resend.com — needs RESEND_API_KEY
EMAIL_PROVIDER=file

# The From address. Required by smtp and resend.
# EMAIL_FROM=BRANDOS <no-reply@yourdomain.com>

# EMAIL_PROVIDER=resend
# RESEND_API_KEY=

# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Database ------------------------------------------------------------------
# NOTE: DATABASE_URL belongs in web/.env, NOT here and not in .env.local. The Prisma
# CLI reads only .env, while Next.js reads both — so keeping it in .env means one
# value serves `prisma migrate` and the running app. Both files are gitignored.
#
# Start Postgres, then create the tables:
#   docker compose up -d db          (from the repo root; listens on 127.0.0.1:5433)
#   cd web && npx prisma migrate deploy
#   cd web && npx prisma generate    (after any schema change)
#
# Put this line in web/.env:
#   DATABASE_URL=postgresql://postgres:brandos_dev_pw@127.0.0.1:5433/brandos?schema=public
#
# Only the /api/projects/* routes need it. The discovery page at
# /project/[id]/discover keeps its state in the browser and works without a database.
