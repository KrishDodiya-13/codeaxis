# Copy this file to web/.env.local and fill it in. .env.local is gitignored.

# --- Model credential (REQUIRED) -----------------------------------------------
# Google Gemini. Server-side only: the stages call the model in-process, so this key
# never leaves the server and is never bundled for the browser.
# Never rename this to NEXT_PUBLIC_ANYTHING — that would ship it to the client.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6KnnVDRAw8v7J7gbYvQYLZHWLKOZ4WQeCZ1_THnU2yA5w

# Optional. Overrides the default model (gemini-3.8-flash). Useful if that model is
# deprecated or you hit its per-model free-tier daily quota.
# GEMINI_MODEL=gemini-3-flash-preview

# --- Database ------------------------------------------------------------------
# Only needed by the /api/projects/* routes. The discovery page at
# /project/[id]/discover keeps its state in the browser and does not need this.
#   npx prisma migrate dev     (first run, creates the tables)
#   npx prisma generate        (after any schema change)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/brandos
