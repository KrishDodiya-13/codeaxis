# --- Database -----------------------------------------------------------------
# Required by the /api/projects/* routes. Prisma reads this.
#   npx prisma migrate dev     (first run, creates the tables)
#   npx prisma generate        (after any schema change)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/brandos

# --- Model credential ----------------------------------------------------------
# Server-side only. Never prefix this with NEXT_PUBLIC_, which would ship it to the
# browser. The /api/projects/:id/discovery and /position routes call the model
# in-process, so the key never leaves the server.
ANTHROPIC_API_KEY=sk-ant-...

# --- Legacy: the standalone engine proxy ---------------------------------------
# Only used by /api/discover, which forwards to a separate `brandstate serve`
# process and does not persist anything. The /api/projects/* routes replace it and
# need no second process. Kept until the discovery page is moved across.
BRANDSTATE_API_URL=http://127.0.0.1:8787
